{
  "name": "modelstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent 3D creation studio with a headless modeling engine, HTTP API, CLI and MCP server.",
  "bin": {
    "modelstudio": "./bin/modelstudio.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node src/server/main.mjs",
    "start:vr": "node src/server/main.mjs --https",
    "build": "node scripts/build.mjs",
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "mcp": "node src/mcp/main.mjs",
    "cli": "node bin/modelstudio.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "jpeg-js": "^0.4.4",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  },
  "files": [
    "src",
    "bin",
    "scripts",
    "web",
    "public",
    "docs",
    "README.md"
  ]
}